{
  "name": "jev-games",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test",
    "check": "node --check main.js && node --check race.js && node --check desktop/main.cjs && node --check desktop/service.mjs && node --check worker/src/index.js",
    "start:desktop": "electron .",
    "build:exe": "electron-builder --win portable --x64"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.hamsterpark.jevxiangqi",
    "productName": "Jev Games",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "worker/src/**/*",
      "assets/**/*",
      "index.html",
      "race.html",
      "race.js",
      "race.css",
      "main.js",
      "piece-labels.js",
      "style.css",
      "service.css",
      "favicon.svg"
    ],
    "electronDownload": {
      "checksums": {
        "electron-v44.4.3-win32-x64.zip": "790a355b684d5c7cc8dc3cdd8c4cca7c4b2d054685427c7554a956879a82e70b"
      }
    },
    "win": {
      "target": ["portable"],
      "signAndEditExecutable": false,
      "artifactName": "Jev-Games-${version}-${arch}-portable.${ext}"
    }
  }
}
